<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<ProjectReference Include="..\Museum.Domain\Museum.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Pomelo.EntityFrameworkCore.MySql" Version="13.6.5" />

		<!-- Закрепляем исправленную версию: транзитивная содержит уязвимость (NU1902) -->
		<PackageReference Include="MySqlConnector" Version="2.6.2" />

		<!-- Pomelo пока не поддерживает EF Core 10, поэтому остаёмся на 9.0.x -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.23" />
		
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.23">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

</Project>